# Build outputs
node_modules/
dist/
build/
out/
coverage/
*.tsbuildinfo

# The Vite production bundle served by @lightbeam/server. Generated by
# `npm run build:web` and refreshed automatically by `npm test`.
apps/server/public/

# Session telemetry written at runtime by the backend. Contains metadata only
# (counts, sizes, timings) - never file content or passphrases.
apps/server/data/

# Environment files and local secrets
.env
.env.*
!.env.example
*.local

# Editors and OS cruft
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store
Thumbs.db
*.swp

# Logs
*.log
npm-debug.log*
yarn-error.log*
